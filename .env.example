# Copy to .env and adjust. `.env` is gitignored.
# No ANTHROPIC_API_KEY needed — Jarvis runs on your Claude subscription via the local `claude`
# CLI (Claude Code). Just make sure you've run `claude` once and logged in.

# --- Core brain (Phase 1) ---
JARVIS_MODEL=              # blank = your Claude Code default; or "opus" / "sonnet" / a full id
JARVIS_EFFORT=medium      # low | medium | high | xhigh | max
JARVIS_USER_NAME=sir      # how Jarvis addresses you

# Toggles
JARVIS_ENABLE_WEB=1               # allow the built-in web search/fetch tools
JARVIS_ALLOW_UNCONFIRMED_SHELL=0  # 1 = skip the confirm prompt for risky commands (not recommended)

# --- Obsidian memory brain (Phase 2+) ---
JARVIS_VAULT=~/JarvisVault

# --- Voice (Phase 5) ---
JARVIS_VOICE_BACKEND=auto     # auto | local (keyless: openWakeWord+Whisper+Piper) | cloud (keys below)
JARVIS_WHISPER_MODEL=base.en  # local STT model (tiny.en/base.en/small.en) — auto-downloads
# JARVIS_PIPER_MODEL=~/.local/share/jarvis/piper/en_GB-alan-medium.onnx
# JARVIS_WAKE_THRESHOLD=0.5
# Cloud keys (only if backend=cloud):
PICOVOICE_ACCESS_KEY=     # wake word — console.picovoice.ai (free)
DEEPGRAM_API_KEY=         # speech-to-text — deepgram.com
ELEVENLABS_API_KEY=       # text-to-speech — elevenlabs.io
# Tuning (optional):
JARVIS_WAKE_KEYWORD=jarvis
JARVIS_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # ElevenLabs voice id (default: "Rachel")
JARVIS_TTS_MODEL_ID=eleven_turbo_v2_5
JARVIS_STT_MODEL=nova-3
JARVIS_SILENCE_MS=800        # trailing silence that ends a spoken phrase
JARVIS_MAX_UTTERANCE_S=15
JARVIS_FOLLOW_UP_S=6         # keep-listening window after a reply (no wake word)
JARVIS_BARGE_IN=1            # 1 = let you talk over Jarvis to interrupt (set 0 if echo false-triggers)
JARVIS_VAD_THRESHOLD=0       # 0 = auto-calibrate from ambient noise; else a fixed RMS threshold
JARVIS_INPUT_DEVICE=-1       # -1 = default mic; else an index from `--check`
JARVIS_OUTPUT_DEVICE=-1      # -1 = default speaker; else an index from `--check`

# --- Proactive routines (Phase 4) ---
JARVIS_ENABLE_BRIEF=1
JARVIS_BRIEF_TIME=07:00      # 24h HH:MM for the daily morning briefing

# --- Remote access (Telegram) ---
TELEGRAM_BOT_TOKEN=              # from @BotFather
TELEGRAM_ALLOWED_CHAT_IDS=       # optional comma-separated chat ids to restrict access

# --- Google (Calendar / Gmail / Tasks) ---
GOOGLE_CLIENT_SECRET_FILE=~/.config/jarvis/client_secret.json   # OAuth desktop client JSON; then run --google-auth

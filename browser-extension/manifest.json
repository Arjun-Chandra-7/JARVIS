{
  "manifest_version": 3,
  "name": "Jarvis Browser Control",
  "version": "1.0.0",
  "description": "Lets Jarvis drive the tabs you already have open, without restarting the browser.",
  "permissions": ["debugger", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jarvis Browser Control"
  }
}

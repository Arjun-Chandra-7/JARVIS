{
  "_comment": "The one description of what the teaching overlay accepts. Read by jarvis/teach/protocol.py (before sending) and overlay/teach/protocol.js (the Electron main process, before anything reaches the renderer). A field not listed here is rejected; nothing here carries code, a URL or a path.",
  "version": 1,
  "limits": {
    "max_batch_commands": 160,
    "max_objects": 400,
    "max_groups": 24,
    "max_anchors": 16,
    "max_points": 4000,
    "max_terms": 16,
    "max_text": 200,
    "max_id": 48,
    "max_coord": 16000,
    "max_size": 16000,
    "max_anim_ms": 12000,
    "max_delay_ms": 30000,
    "max_schedule_ahead_ms": 30000,
    "max_anchor_age_ms": 6000,
    "max_anchor_ttl_ms": 60000,
    "max_monitor": 15,
    "max_payload_bytes": 400000
  },
  "colors": ["primary", "confirm", "attention", "error", "text", "muted", "backing", "none"],
  "envelope": {
    "v": "int:1..1",
    "lesson": "id",
    "gen": "int:0..9000000000000000",
    "seq": "int:0..1000000000",
    "at": "?epoch",
    "sent": "?epoch",
    "cmds": "commands"
  },
  "ops": {
    "scene.create": {"scene": "id", "monitor": "monitor", "theme": "?theme", "region": "?rect", "objects": "?objects"},
    "scene.update": {"theme": "?theme", "transform": "?transform"},
    "scene.clear": {"group": "?id", "keep_groups": "?ids"},
    "shape.add": {"object": "object"},
    "shape.update": {"id": "id", "patch": "patch"},
    "shape.remove": {"id": "id", "fade_ms": "?ms"},
    "group.add": {"id": "id", "visible": "?bool", "dim": "?unit"},
    "group.remove": {"id": "id"},
    "stroke.draw": {"object": "object"},
    "highlight.show": {"target": "ref", "color": "?color", "pulse": "?bool", "ms": "?ms"},
    "highlight.hide": {"target": "?ref"},
    "focus.show": {"targets": "refs", "dim": "?unit"},
    "focus.hide": {},
    "timeline.play": {"timeline": "id"},
    "timeline.pause": {"timeline": "?id"},
    "timeline.resume": {"timeline": "?id", "at": "?epoch"},
    "timeline.seek": {"timeline": "id", "to_ms": "ms"},
    "timeline.cancel": {"timeline": "?id"},
    "anchor.attach": {"anchor": "anchor"},
    "anchor.detach": {"id": "id"}
  },
  "objects": {
    "_common": {"id": "id", "type": "otype", "group": "?id", "anchor": "?id", "z": "?int:-100..100", "style": "?style", "anim": "?anim", "visible": "?bool"},
    "stroke":      {"points": "points"},
    "highlighter": {"points": "points"},
    "line":        {"from": "point", "to": "point"},
    "arrow":       {"from": "point", "to": "point", "head": "?num:4..48", "bend": "?num:-1..1"},
    "rect":        {"x": "coord", "y": "coord", "w": "size", "h": "size", "r": "?num:0..400"},
    "circle":      {"cx": "coord", "cy": "coord", "r": "num:1..8000"},
    "ellipse":     {"cx": "coord", "cy": "coord", "rx": "num:1..8000", "ry": "num:1..8000"},
    "triangle":    {"points": "tri"},
    "right_angle": {"at": "point", "a": "point", "b": "point", "size": "?num:4..120"},
    "text":        {"x": "coord", "y": "coord", "text": "text", "size": "?num:8..120", "align": "?enum:start,middle,end", "weight": "?enum:400,500,600,700", "backing": "?bool", "font": "?enum:sans,math,mono"},
    "equation":    {"x": "coord", "y": "coord", "terms": "terms", "size": "?num:12..160", "align": "?enum:start,middle,end", "backing": "?bool"},
    "node":        {"x": "coord", "y": "coord", "w": "size", "h": "size", "label": "text", "sub": "?text", "icon": "?enum:none,user,doc,chunks,vector,db,search,context,model,answer,warn,tune"},
    "edge":        {"from": "id", "to": "id", "label": "?text", "bend": "?num:-1..1", "flow": "?bool"},
    "region":      {"x": "coord", "y": "coord", "w": "size", "h": "size", "pad": "?num:0..60", "label": "?text"},
    "spotlight":   {"x": "coord", "y": "coord", "w": "size", "h": "size", "dim": "?unit", "round": "?bool"},
    "pulse":       {"x": "coord", "y": "coord", "r": "?num:4..200", "repeat": "?int:1..12"},
    "panel":       {"x": "coord", "y": "coord", "w": "size", "h": "size", "title": "?text"}
  },
  "patchable": ["group", "anchor", "z", "style", "anim", "visible", "points", "from", "to", "head", "bend", "x", "y", "w", "h", "r", "cx", "cy", "rx", "ry", "at", "a", "b", "size", "text", "align", "weight", "backing", "terms", "label", "sub", "icon", "pad", "dim", "round", "repeat", "title", "flow"],
  "style": {"color": "?color", "fill": "?color", "width": "?num:0.5..48", "opacity": "?unit", "fill_opacity": "?unit", "glow": "?unit", "dash": "?enum:solid,dashed,dotted"},
  "anim": {"kind": "enum:none,draw,fade,pop,grow,flow", "ms": "ms", "delay": "?delay", "ease": "?enum:linear,out,inout", "timeline": "?id"},
  "theme": {"palette": "?enum:jarvis,light,contrast", "glow": "?unit", "text_scale": "?num:0.6..2.5", "reduced_motion": "?bool"},
  "transform": {"scale": "?num:0.4..3", "dx": "?num:-8000..8000", "dy": "?num:-8000..8000", "origin": "?point", "ms": "?ms"},
  "anchor": {
    "id": "id",
    "source": "enum:dom,atspi,region,screen",
    "element_id": "?text",
    "application": "?text",
    "window": "?text",
    "bounds": "rect",
    "confidence": "unit",
    "observed_at": "epoch",
    "ttl_ms": "int:100..60000",
    "monitor": "monitor",
    "scale": "num:0.5..4",
    "tracking": "enum:static,follow,hide_on_change"
  },
  "term": {"id": "id", "text": "text", "sup": "?text", "color": "?color"}
}
